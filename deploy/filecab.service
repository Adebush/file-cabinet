[Unit]
Description=File Cabinet (private file manager + pickup codes)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/filecab
ExecStart=/opt/filecab/.venv/bin/gunicorn -w 2 -k gthread --threads 8 \
    -b 127.0.0.1:8090 --timeout 900 --graceful-timeout 30 app:app
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
